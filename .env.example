# Server
HTTP_ADDR=:8080
READ_TIMEOUT=10s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s
MAX_REQUEST_BODY_MB=1
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/usermgmt?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE=5m
DB_HEALTH_CHECK_PERIOD=1m

# Redis (optional, falls back to in-memory TTL cache if empty)
REDIS_URL=redis://localhost:6379/0

# JWT (must be >= 32 bytes)
JWT_SECRET=super-secret-must-be-at-least-32-bytes-long!
JWT_KID=v1
JWT_ISSUER=usermgmt
JWT_AUDIENCE=usermgmt-api
ACCESS_TTL=15m
REFRESH_TTL=168h

# Security / Hashing
BCRYPT_COST=12

# Cache TTLs
PERM_CACHE_TTL=5m
TENANT_CACHE_TTL=30s

# Migrations & Features
MIGRATIONS_PATH=migrations
ENABLE_RLS=false

